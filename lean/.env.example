# ==============================================================================
# LEAN IMMUTABLE POD - ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual values
# 3. NEVER commit the .env file to version control
# 4. Add .env to .gitignore
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Docker Image Configuration
# ------------------------------------------------------------------------------

# LEAN base image digest (immutable reference)
# To get current digest:
#   docker pull quantconnect/lean:latest
#   docker image inspect quantconnect/lean:latest --format '{{index .RepoDigests 0}}'
LEAN_BASE_DIGEST=sha256:8c1e1b4e8e8c8f8e8e8e8e8e8e8e8e8e8e8e8e8e8e8e8e8e8e8e8e8e8e8e8e8e

# Version tag for your custom-built image
LEAN_VERSION=1.0.0

# ------------------------------------------------------------------------------
# LEAN Engine Configuration
# ------------------------------------------------------------------------------

# LEAN operating mode: backtesting, live-paper, live
LEAN_MODE=backtesting

# LEAN environment: live-paper (paper trading) or live (real trading)
LEAN_ENVIRONMENT=live-paper

# ------------------------------------------------------------------------------
# QuantConnect API Credentials
# ------------------------------------------------------------------------------
# Get these from: https://www.quantconnect.com/account

# Your QuantConnect API token
QC_API_TOKEN=

# Your QuantConnect user ID
QC_USER_ID=

# Your QuantConnect organization ID (if applicable)
QC_ORGANIZATION_ID=

# ------------------------------------------------------------------------------
# Brokerage API Credentials
# ------------------------------------------------------------------------------
# Configure credentials for your broker(s)

# Interactive Brokers
IB_ACCOUNT=
IB_USER_NAME=
IB_PASSWORD=
IB_TRADING_MODE=paper

# OANDA
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=Practice

# TD Ameritrade
TD_ACCESS_TOKEN=
TD_REFRESH_TOKEN=
TD_CLIENT_ID=
TD_REDIRECT_URI=

# Coinbase Pro
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Alpaca
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_TRADING_MODE=paper

# ------------------------------------------------------------------------------
# Volume Mount Paths
# ------------------------------------------------------------------------------
# Paths on your host machine (absolute or relative)

# Directory containing your algorithm files (.py, .cs)
ALGORITHM_PATH=./algorithms

# Directory containing your LEAN config.json
CONFIG_PATH=./config

# Directory for market data cache
DATA_PATH=./data

# Directory for backtest/live results
RESULTS_PATH=./results

# Directory for LEAN logs
LOGS_PATH=./logs

# ------------------------------------------------------------------------------
# Port Configuration
# ------------------------------------------------------------------------------

# Port for remote debugging (Python debugger)
LEAN_DEBUG_PORT=5678

# Port for LEAN API (live trading)
LEAN_API_PORT=8080

# Port for Jupyter notebook (research environment)
JUPYTER_PORT=8888

# Jupyter authentication token
JUPYTER_TOKEN=lean-research-token-change-me

# ------------------------------------------------------------------------------
# Resource Limits
# ------------------------------------------------------------------------------

# CPU limits (number of cores)
LEAN_CPU_LIMIT=4.0
LEAN_CPU_RESERVATION=2.0

# Memory limits (e.g., 8G, 4096M)
LEAN_MEMORY_LIMIT=8G
LEAN_MEMORY_RESERVATION=4G

# ------------------------------------------------------------------------------
# Network Configuration
# ------------------------------------------------------------------------------

# Subnet for LEAN Docker network
LEAN_SUBNET=172.25.0.0/16

# ------------------------------------------------------------------------------
# System Configuration
# ------------------------------------------------------------------------------

# Timezone (use IANA timezone format)
# Common values: America/New_York, America/Chicago, America/Los_Angeles,
#                Europe/London, Asia/Hong_Kong, Asia/Singapore
TZ=America/New_York

# Python optimization level (0=none, 1=basic, 2=full)
PYTHONOPTIMIZE=1

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable verbose logging
LEAN_VERBOSE=false

# ------------------------------------------------------------------------------
# Data Provider Configuration
# ------------------------------------------------------------------------------

# Data provider: QuantConnect, IEX, Polygon, AlphaVantage, etc.
DATA_PROVIDER=QuantConnect

# IEX Cloud API Key (if using IEX as data provider)
IEX_CLOUD_API_KEY=

# Polygon.io API Key (if using Polygon as data provider)
POLYGON_API_KEY=

# Alpha Vantage API Key (if using Alpha Vantage as data provider)
ALPHA_VANTAGE_API_KEY=

# ------------------------------------------------------------------------------
# Security Configuration
# ------------------------------------------------------------------------------

# Enable/disable security features
ENABLE_SECURITY=true

# Run with read-only root filesystem (experimental)
READ_ONLY_ROOT=false

# ------------------------------------------------------------------------------
# Advanced Configuration
# ------------------------------------------------------------------------------

# Custom Python path additions (colon-separated)
CUSTOM_PYTHONPATH=

# JOB ID (for tracking multiple backtest jobs)
JOB_ID=

# Algorithm ID (for tracking specific algorithms)
ALGORITHM_ID=

# ------------------------------------------------------------------------------
# Development/Debug Configuration
# ------------------------------------------------------------------------------

# Enable development mode (mount code as writable)
DEV_MODE=false

# Enable Python debugger on startup
ENABLE_DEBUGGER=false

# Debugger wait for attach
DEBUGGER_WAIT=false

# ==============================================================================
# SECURITY WARNING
# ==============================================================================
#
# This file contains sensitive credentials and API keys.
#
# NEVER commit this file to version control!
# NEVER share this file publicly!
# NEVER include it in Docker images!
#
# Ensure .env is listed in your .gitignore file.
#
# ==============================================================================
