# Environment variables (NEVER commit credentials!)
.env

# Data directories (but keep .gitkeep)
data/*
!data/.gitkeep
results/*
!results/.gitkeep
logs/*
!logs/.gitkeep
storage/*
!storage/.gitkeep

# Algorithm workspace (ignore user algorithms but keep examples)
algorithms/*.py
!algorithms/example_algorithm.py
!algorithms/custom_data_alert_strategy.py
notebooks/

# Configuration (may contain sensitive info)
config/*.json
!config/config.example.json
!config/config.custom.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Backups
*.bak
*.backup
*.old

# Temporary files
*.tmp
*.temp
tmp/
temp/
